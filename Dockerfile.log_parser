FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1

# Sao chép Docker CLI chính thức từ image docker:cli
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app

# Cài đặt thư viện bất đồng bộ aiohttp cho Telegram SOAR Bot
RUN pip install --no-cache-dir aiohttp>=3.9.0

# Sao chép mã nguồn log parser & SOAR bot
COPY log_parser.py /app/log_parser.py

CMD ["python3", "log_parser.py"]
